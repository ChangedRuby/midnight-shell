# Local build of the ChangedRuby/midnight-shell fork (Caelestia shell fork).
# Not published to the AUR: build it with scripts/update-shell.sh.
# Maintainer: ChangedRuby

pkgname='midnight-ruby-git'
_pkgname='midnight-shell'
pkgver=r3335.2c933d8
pkgrel=1
pkgdesc="ChangedRuby's fork of the MiDnight/Caelestia shell"
arch=('x86_64' 'aarch64')
url='https://github.com/ChangedRuby/midnight-shell'
license=('GPL-3.0-only')

depends=(
    'bash'
    'fish'
    'glibc'
    'gcc-libs'
    'qt6-base'
    'qt6-declarative'
    'qt6-imageformats'
    'qt6-multimedia'
    'protobuf'
    'caelestia-cli'
    'quickshell-git'
    'ddcutil'
    'brightnessctl'
    'libcava'
    'networkmanager'
    'lm_sensors'
    'aubio'
    'libpipewire'
    'ttf-material-symbols-variable'
    'power-profiles-daemon'
    'ttf-rubik-vf'
    'ttf-cascadia-code-nerd'
    'swappy'
    'libqalculate'
    'qt6-m3shapes'
)

makedepends=(
    'git'
    'cmake'
    'ninja'
    'qt6-shadertools'
)

# Same names the upstream packages provide, so nothing that depends on the
# shell notices the swap.
provides=(
    "${_pkgname}=${pkgver}"
    'midnight-shell'
    'caelestia-shell'
    'caelestia-shell-git'
)
conflicts=(
    'midnight-shell'
    'midnight-shell-git'
    'dim-caelestia-shell-git'
    'caelestia-shell'
    'caelestia-shell-git'
    'noctalia-qs'
    'noctalia-qs-git'
    'polkit-gnome'
)

source=("${pkgname}::git+https://github.com/ChangedRuby/midnight-shell.git#branch=main")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${pkgname}"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cd "${srcdir}/${pkgname}"

    # CXX/CC are set explicitly: a stale compiler from the environment (for
    # example clazy from a direnv shell) would break the configure step.
    CXX=g++ CC=gcc cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/ \
        -DVERSION="$(git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//')" \
        -DGIT_REVISION="$(git rev-parse --short HEAD)" \
        -DDISTRIBUTOR="local (package: $pkgname)"
    cmake --build build
}

package() {
    cd "${srcdir}/${pkgname}"

    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
